# Server
NODE_ENV=development
PORT=4000
APP_TIMEZONE=Africa/Nairobi
DEFAULT_CURRENCY=KES

# Supabase PostgreSQL (Transaction Pooler + Direct/Session URL for migrations)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# JWT & Cookies (use strong 64+ char random secrets in production)
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret-key"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# CORS
CORS_ORIGIN="http://localhost:5173"
